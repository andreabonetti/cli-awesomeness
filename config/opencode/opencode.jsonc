{
  "$schema": "https://opencode.ai/config.json",
  // permissions
  "permission": {
    "bash": {
      // ask for everything
      "*": "ask",
      // exceptions
      // ...tools
      "edit": "allow",
      "write": "allow",
      "read": "allow",
      "grep": "allow",
      "glob": "allow",
      "mkdir *": "allow",
      "apply_patch": "allow",
      "skill": "allow",
      "todowrite": "allow",
      "webfetch": "allow",
      "websearch": "allow",
      "question": "allow",
      // ...bash
      "ls *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "find *": "allow",
      // ...git
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      // ...apps
      "pytest *": "allow",
      "ruff *": "allow"
    }
  },
  // models
  "model": "deepseek/deepseek-v4-pro",
  "small_model": "deepseek/deepseek-v4-flash",
  // providers:
  // - local (running on your machine)
  // - deepseek
  "provider": {
    "local": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "name": "Local Llama",
        "baseURL": "http://localhost:8080/v1",
        "apiKey": "dummy"
      },
      "models": {
        "llama": {}
      }
    },
    "deepseek": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DeepSeek",
      "options": {
        "baseURL": "https://api.deepseek.com/v1",
        "apiKey": "{env:DEEPSEEK_API_KEY}"
      },
      "models": {
        "deepseek-v4-pro": { "name": "DeepSeek V4 Pro" },
        "deepseek-v4-flash": { "name": "DeepSeek V4 Flash" }
      }
    }
  }
}